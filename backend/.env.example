# ==========================================
# 骑手支付绑定 —— 自动登录模块配置（模板）
# 复制本文件为同名 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库（敏感凭证）
# ==========================================

# 平台根域名（用于请求头 Origin/Referer）
LOGIN_BASE=https://mozi-login.alibaba-inc.com

# 登录页 URL（先 GET 预热，拿到初始 session cookie，部分 SSO 必需）
LOGIN_PAGE_URL=https://mozi-login.alibaba-inc.com/?APP_NAME=LOGISTICS_COMPANY&BACK_URL=https%3A%2F%2Faeolus.ele.me%3F_tplCode%3Dmknnjrtsvw9cj96u&moziAppType=LOGISTICS_COMPANY

# 发送短信验证码接口（Mozi JSON-RPC 示例）
LOGIN_SEND_SMS_URL=https://mozi-login.alibaba-inc.com/rpc/sms/send_login_sms_code.json

# 提交验证码完成登录接口（带 APP_NAME/BACK_URL 回跳 aeolus.ele.me）
LOGIN_VERIFY_URL=https://mozi-login.alibaba-inc.com/rpc/login/doLogin.json?APP_NAME=LOGISTICS_COMPANY&BACK_URL=https%3A%2F%2Faeolus.ele.me%3F_tplCode%3Dmknnjrtsvw9cj96u&moziAppType=LOGISTICS_COMPANY

# 请求体模板：用 {phone} {code} 占位，按真实接口字段名调整
#   例：若真实字段是 mobile / smsCode，改为 {"mobile":"{phone}","smsCode":"{code}"}
LOGIN_SEND_SMS_BODY={"phone":"{phone}"}
LOGIN_VERIFY_BODY={"phone":"{phone}","code":"{code}"}

# 请求 Content-Type：application/json 或 application/x-www-form-urlencoded
LOGIN_CONTENT_TYPE=application/json

# 额外请求头（JSON 对象）。Mozi 等 SSO 常需要：
# LOGIN_EXTRA_HEADERS={"X-Requested-With":"XMLHttpRequest"}
LOGIN_EXTRA_HEADERS={"X-Requested-With":"XMLHttpRequest"}

# 额外请求体字段（JSON 对象），会与模板合并。按需填写：
# LOGIN_EXTRA_BODY={"source":"web","appName":"LOGISTICS_COMPANY"}
LOGIN_EXTRA_BODY={}

# 兼容旧配置：扁平字段名（未使用模板时备用）
LOGIN_FIELD_PHONE=phone
LOGIN_FIELD_CODE=code

# Aeolus 业务应用入口（推荐）：SSO 登录后访问真实业务页面，让页面 JS 自动调用
# httpizza.ele.me 接口并建立会话 Cookie。请替换为你实际使用的 Aeolus 首页 URL。
AEOLUS_APP_URL=https://aeolus.ele.me/?targetId=51388#/app/fnjp-gfe/pikipek-apps/dashboard/index.html

# 备用：当未配置 AEOLUS_APP_URL 时，直接访问 httpizza 域的该地址触发 Cookie 下发。
HTTPPIZZA_WARMUP_URL=https://httpizza.ele.me/lpd.meepo.session/aeolus/switchAgency?toAgencyId=31030156
