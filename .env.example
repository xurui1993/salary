# ==========================================
# 本地与局域网运行环境配置模板 (.env.example)
# 复制为 .env 后按实际部署环境填写所需配置项
# ==========================================

# ---- 服务监听与端口 ----
# 监听 0.0.0.0 以允许局域网内其他电脑通过主机 IP 访问（默认 0.0.0.0）
HOST=0.0.0.0
# Web 服务端口（本机与局域网浏览器访问端口，默认 3000）
APP_PORT=3000
# 内部 Python 核心服务端口（仅监听 127.0.0.1 回环，默认 8009）
BACKEND_PORT=8009
# 可选：指定本地 Python 解释器绝对路径（默认自动使用 python / python3）
PYTHON_PATH=
# 可选：自定义本地下载归档根目录
FENGSHEN_DOWNLOAD_ROOT=

# ---- 公开注册与安全策略 ----
# 是否开启后台公开注册接口 POST /api/auth/register（默认 1 开启，设为 0 关闭）
ALLOW_SELF_REGISTRATION=1
# 单来源 IP 每 15 分钟允许提交的公开注册上限（默认 10）
REGISTER_RATE_LIMIT=10
# 待管理员审批队列的最大容量上限（默认 100）
PENDING_QUEUE_LIMIT=100
# 可选：额外允许跨域访问的完整来源列表（逗号分隔，例如 http://payroll.internal:3000）
ALLOWED_ORIGINS=
# 可选：自定义内网域名白名单（逗号分隔）
NG_ALLOWED_HOSTS=

# ---- 外部业务平台接入配置（按需填写，切勿提交真实密钥） ----
AEOLUS_APP_URL=
HTTPPIZZA_WARMUP_URL=
LOGIN_BASE=
LOGIN_CONTENT_TYPE=
LOGIN_EXTRA_BODY=
LOGIN_EXTRA_HEADERS=
LOGIN_FIELD_CODE=
LOGIN_FIELD_PHONE=
LOGIN_PAGE_URL=
LOGIN_SEND_SMS_BODY=
LOGIN_SEND_SMS_URL=
LOGIN_VERIFY_BODY=
LOGIN_VERIFY_URL=
GEMINI_API_KEY=